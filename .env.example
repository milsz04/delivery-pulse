# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# --- Superset ------------------------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_PASSWORD=admin

# --- GitHub (ETL) ------------------------------------------------------------------
# Fine-grained token: github.com -> Settings -> Developer settings -> Personal access tokens
# -> Fine-grained tokens -> "Public repositories (read-only)". Without it: 60 requests/hour.
GITHUB_TOKEN=
REPOS=apache/superset,fastapi/fastapi
DAYS_BACK=90
ETL_INTERVAL_MINUTES=60

# --- LLM -------------------------------------------------------------------------------
# anthropic: needs ANTHROPIC_API_KEY (console.anthropic.com)
# ollama:    free, local - install Ollama on the Mac and run: ollama pull qwen2.5-coder:7b
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
REPORT_LANGUAGE=English

# --- Weekly report schedule ----------------------------------------------------------
TZ=Europe/Warsaw
REPORT_CRON=0 8 * * mon

# --- Notifications (all optional; set the ones you want) -----------------------------
# Discord: Server settings -> Integrations -> Webhooks -> New webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# Slack: api.slack.com/apps -> Create app -> Incoming Webhooks
SLACK_WEBHOOK_URL=
# E-mail via SMTP (Gmail: smtp.gmail.com, port 587, an App Password - not your normal password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
